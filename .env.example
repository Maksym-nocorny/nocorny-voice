# Required
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=

# Webhook (Render). Leave both empty for local polling mode.
PORT=
WEBHOOK_URL=

# --- Optional overrides (defaults shown) ---
# GEMINI_MODEL=gemini-2.5-flash-lite
# TRANSCRIBE_MAX_TOKENS=8192
# TRANSCRIBE_TEMPERATURE=0.0
# GEMINI_RETRY_ATTEMPTS=2
# GEMINI_RETRY_BASE_DELAY=1.0

# Media limits
# MAX_DURATION_SEC=1800       # 30 minutes
# MAX_FILE_SIZE_MB=50

# Per-user rate limit
# RATE_LIMIT_REQUESTS=5
# RATE_LIMIT_WINDOW_SEC=60

# Cache
# CACHE_MAX_SIZE=1000
# CACHE_TTL_SEC=86400         # 24 hours
