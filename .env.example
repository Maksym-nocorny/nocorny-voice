# Required
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=

# Webhook (Render). Leave both empty for local polling mode.
PORT=
WEBHOOK_URL=

# --- Optional overrides (defaults shown) ---
# GEMINI_MODEL=gemini-flash-lite-latest
# TRANSCRIBE_MAX_TOKENS=8192
# TRANSCRIBE_TEMPERATURE=0.0
# GEMINI_RETRY_ATTEMPTS=2
# GEMINI_RETRY_BASE_DELAY=1.0
# Rate limits (429) wait longer than 5xx — a throttled free-tier window lasts
# minutes. Defaults below wait 2+4+8+16 ≈ 30 s before giving up on a request.
# GEMINI_RATE_LIMIT_RETRY_ATTEMPTS=4
# GEMINI_RATE_LIMIT_RETRY_BASE_DELAY=2.0

# Pricing per 1M tokens for /stats cost calculations (Google AI paid-tier defaults).
# Set both to 0 to hide all cost output and only show token counts.
# PRICE_PER_1M_INPUT_TOKENS=0.10
# PRICE_PER_1M_OUTPUT_TOKENS=0.40

# Media limits
# MAX_DURATION_SEC=1800       # 30 minutes
# MAX_FILE_SIZE_MB=50

# Per-user rate limit
# RATE_LIMIT_REQUESTS=5
# RATE_LIMIT_WINDOW_SEC=60

# Cache
# CACHE_MAX_SIZE=1000           # L1 (in-memory), max entries
# CACHE_TTL_SEC=86400           # L1 TTL: 24 hours
# CACHE_L2_TTL_DAYS=14          # L2 (Neon Postgres, content-hash) TTL. Set to 0 to disable L2 entirely (saves Neon CU).

# Analytics (Neon Postgres). Leave DATABASE_URL empty to disable analytics entirely.
DATABASE_URL=                # postgresql://user:pwd@ep-xxx.neon.tech/dbname?sslmode=require
ADMIN_USER_ID=               # Telegram user_id authorised to use /stats
# ANALYTICS_QUEUE_SIZE=2000
# ANALYTICS_BATCH_SIZE=100
# ANALYTICS_FLUSH_INTERVAL_SEC=1800.0    # 30 min: lets Neon auto-suspend between flushes
# ANALYTICS_HEARTBEAT_INTERVAL_SEC=0     # 0 = disabled. Set to 240 to keep DB warm (raises Neon cost).
# ANALYTICS_RETENTION_DAYS=90
